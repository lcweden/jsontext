{
  "tasks": {
    "test": "deno test --coverage --allow-all",
    "check": "deno check && deno fmt --check && deno lint",
    "format": "deno fmt",
    "lint": "deno lint"
  },
  "imports": {
    "#src/*": "./src/*.ts",
    "#std/assert": "jsr:@std/assert@1"
  },
  "fmt": {
    "lineWidth": 100
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-sloppy-imports"]
    }
  },
  "exclude": ["node_modules/", "public/", "dist/"]
}
